# node-linker=isolated is deliberate and must stay: with pnpm's virtual store,
# `pnpm list --json` reports paths that actually exist. Switching to
# node-linker=hoisted was measured to make things WORSE - `pnpm list` then emits
# node_modules/.pnpm/<pkg>@<ver>/... paths that do not exist on disk, so
# electron-builder's collector cannot read any nested package.json.
shamefully-hoist=true
node-linker=isolated

# Electron / electron-builder binaries are fetched from the official sources so
# release artifacts stay reproducible and verifiable. Developers behind a slow
# link can opt in locally instead of changing this file:
#   export ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
#   export ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
